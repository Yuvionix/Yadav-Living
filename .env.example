# ==============================================================================
# Yadav Living — Environment Configuration Template
# ==============================================================================
# 👥 REMINDER FOR THE TEAM:
#    "You're writing this for your team, not just for yourself."
#
# QUICK START:
#   1. Copy this template to create your local private environment file:
#        cp .env.example .env.local
#   2. Update DB_USER, DB_PASS, and DB_PORT to match your local MySQL setup.
#   3. .env.local is strictly git-ignored so your private credentials stay safe!
#   For Docker Compose, copy to .env and set unique DB_PASS and DB_ROOT_PASSWORD values.
# ==============================================================================

# Application Environment & Runtime
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_NAME="Yadav Living"

# Database Configuration (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hms
DB_USER=root
DB_PASS=

# Docker Compose credentials (use unique values in your private .env file)
DB_ROOT_PASSWORD=

# Single-container local database only: mount a seed SQL file outside the web root.
DB_SEED_FILE=

# Optional external storage directory for private KYC documents
HMS_PRIVATE_UPLOAD_DIR=

# AI assistant (generate a unique shared token; keep both values private)
# OPENAI_API_KEY is required to generate answers; an OpenAI-compatible API URL/model may be used.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Platform Leadership & Community Administration
PLATFORM_LEAD="Yuvraj"
ADMIN_EMAIL=yuvrajyadav734@gmail.com
PROPERTY_OWNERS="Binod Yadav & Sumit Yadav"

# Session & Security Settings
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
